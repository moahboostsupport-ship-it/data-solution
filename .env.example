# ============================================================
# DATA SOLUTION — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Frontend (VITE_ prefix = exposed to client — NEVER put secrets here)
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------
# Backend (Supabase Edge Functions — server-side only, NEVER expose to frontend)
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------
# Payment Verification (server-side only)
# ------------------------------------------------------------
TUMA_API_KEY=your-tuma-api-key
TUMA_API_SECRET=your-tuma-api-secret
TUMA_WEBHOOK_SECRET=your-webhook-secret

# ------------------------------------------------------------
# Admin Auth (server-side only)
# ------------------------------------------------------------
ADMIN_JWT_SECRET=your-jwt-secret-here

# ------------------------------------------------------------
# Business Config
# ------------------------------------------------------------
MPESA_TILL_NUMBER=3090748
MPESA_TILL_NAME=Victor (Safaricom)
BUSINESS_PHONE=0798507804
